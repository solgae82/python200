
class User:
    def mm(): 
        print('mm')

    @staticmethod
    def static_mm(): 
        print('static mm')


User.mm()
User.static_mm()

user_instance = User()

# 에러,  내부적으로 mm(user_instance)를 넘기지만, 인자를 받지 않게 
# 설계 되므로 아래 코드는 에러
# user_instance.mm()  # 에러 

user_instance.static_mm() # 정적 메소드는 일반 함수와 같다.
